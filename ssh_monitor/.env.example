# Django Settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Django Settings Module
DJANGO_SETTINGS_MODULE=ssh_monitor.settings.local

# Database (PostgreSQL for Docker, SQLite for local dev without Docker)
DATABASE_URL=postgres://ssh_monitor:ssh_monitor@postgres:5432/ssh_monitor

# Redis (Celery broker)
REDIS_URL=redis://redis:6379/0

# Credential Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CREDENTIAL_ENCRYPTION_KEY=

# Logging
LOG_LEVEL=INFO

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
